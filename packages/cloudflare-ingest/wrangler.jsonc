{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "etlayer-ingest",
  "main": "src/index.js",
  "compatibility_date": "2026-09-21",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "ETLAYER_MAX_REQUEST_BYTES": "1048576",
    "ETLAYER_MAX_EVENTS_PER_REQUEST": "1000",
    "ETLAYER_INGEST_RATE_LIMIT_PERIOD_SECONDS": "60",
    "POSTHOG_HOST": "https://eu.i.posthog.com",
    "STATSIG_HOST": "https://api.statsig.com"
  },
  "ratelimits": [
    {
      "name": "ETLAYER_INGEST_RATE_LIMITER",
      "namespace_id": "924001",
      "simple": {
        "limit": 600,
        "period": 60
      }
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "EVENTS",
        "queue": "etlayer-events"
      }
    ],
    "consumers": [
      {
        "queue": "etlayer-events",
        "max_batch_size": 100,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "etlayer-events-dlq"
      }
    ]
  },
  "r2_buckets": [
    {
      "binding": "ARCHIVE",
      "bucket_name": "etlayer-events-archive"
    }
  ],
  "env": {
    "ci": {
      "vars": {
        "ETLAYER_MAX_REQUEST_BYTES": "1048576",
        "ETLAYER_MAX_EVENTS_PER_REQUEST": "1000",
        "ETLAYER_INGEST_RATE_LIMIT_PERIOD_SECONDS": "10",
        "POSTHOG_HOST": "https://eu.i.posthog.com",
        "STATSIG_HOST": "https://api.statsig.com"
      },
      "ratelimits": [
        {
          "name": "ETLAYER_INGEST_RATE_LIMITER",
          "namespace_id": "924002",
          "simple": {
            "limit": 5,
            "period": 10
          }
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "EVENTS",
            "queue": "etlayer-events-ci"
          }
        ],
        "consumers": [
          {
            "queue": "etlayer-events-ci",
            "max_batch_size": 100,
            "max_batch_timeout": 5,
            "max_retries": 5,
            "dead_letter_queue": "etlayer-events-ci-dlq"
          }
        ]
      },
      "r2_buckets": [
        {
          "binding": "ARCHIVE",
          "bucket_name": "etlayer-events-archive-ci"
        }
      ]
    }
  }
}
